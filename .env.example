# Copy to .env.local (dev) or set in your host's build environment.

# Canonical origin used for <link rel="canonical">, Open Graph URLs, JSON-LD and sitemap.xml.
# Set this to the real production domain BEFORE building for release.
VITE_SITE_URL=https://kannadi.ai

# Where the contact form POSTs its JSON (the Book a Demo page embeds the provider's own form and does not use this).
# Any endpoint that accepts a JSON POST works (a serverless function, Formspree, Web3Forms, …).
# If this is empty the form says so honestly; it never pretends a submission succeeded.
VITE_FORM_ENDPOINT=

# Optional public contact address. It is only shown (footer, contact page, form-error fallback)
# when you set it — no company details are invented.
VITE_CONTACT_EMAIL=
