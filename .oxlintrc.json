{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "ignorePatterns": [
    "dist",
    "dist-ssr",
    "node_modules"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/ui/**"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": [
        "scripts/art/scenes/**"
      ],
      "rules": {
        "no-unused-vars": "off",
        "oxc/erasing-op": "off"
      }
    }
  ]
}
